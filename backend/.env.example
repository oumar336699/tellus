# TELLUS Backend Environment Configuration

# Server Configuration
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:8100,http://localhost:4200

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/tellus
MONGODB_TEST_URI=mongodb://localhost:27017/tellus_test

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_change_this_in_production
JWT_REFRESH_EXPIRE=30d

# AI Configuration
OPENAI_API_KEY=your_openai_api_key_here
AI_SCORE_THRESHOLD=90
AI_SCORE_WARNING=70

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads
ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password
SMTP_FROM=noreply@tellus.cm

# SMS Configuration (for appointment reminders)
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=TELLUS

# Application Configuration
APP_NAME=TELLUS
APP_VERSION=2.0.0
REGION=Garoua, Région du Nord, Cameroun
SUPPORT_EMAIL=support@tellus.cm
SUPPORT_PHONE=+237 XX XX XX XX

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session Configuration
SESSION_SECRET=your_session_secret_change_this_in_production
SESSION_MAX_AGE=86400000

# Encryption
ENCRYPTION_KEY=your_encryption_key_change_this_in_production

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log